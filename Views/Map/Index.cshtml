@{
    ViewData["Title"] = "Find Charging Stations";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<style>
    /* Smooth Scroll Behavior */
    html {
        scroll-behavior: smooth;
    }

    /* Hero Panel Styles */
    .hero-panel {
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        margin-top: -2rem; /* Pull up to nav border */
        background: radial-gradient(circle at 80% 20%, #1e2530 0%, #0b0d11 100%);
        color: #ffffff;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        overflow: hidden;
        padding-top: 5.5rem;
        padding-bottom: 8.5rem; /* Spacious padding for slanted divider */
        position: relative;
    }

    .hero-panel::after {
        content: '';
        position: absolute;
        top: 10%;
        right: 15%;
        width: 450px;
        height: 450px;
        background: radial-gradient(circle, rgba(6, 182, 212, 0.15) 0%, transparent 70%);
        pointer-events: none;
        z-index: 1;
    }

    .hero-title {
        font-size: 3.75rem;
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -1px;
        font-family: 'Outfit', sans-serif;
    }

    .hero-subtitle {
        color: #94a3b8;
        font-size: 1.25rem;
        line-height: 1.7;
        font-weight: 400;
        max-width: 540px;
    }

    .badge-low-battery {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.2);
        color: #ef4444;
        padding: 8px 16px;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-radius: 100px;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background-color: #ef4444;
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
        animation: pulseRed 1.6s infinite;
    }

    @@keyframes pulseRed {
        0% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
        }
        70% {
            transform: scale(1);
            box-shadow: 0 0 0 10px rgba(239, 68, 68, 0);
        }
        100% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
        }
    }

    /* Dying Battery CTA Button */
    .dying-battery-btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 16px 36px;
        background: rgba(239, 68, 68, 0.05);
        border: 3px solid #ef4444;
        border-radius: 12px;
        color: #ffffff;
        font-size: 1.05rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        text-decoration: none;
        overflow: visible;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        cursor: pointer;
        box-shadow: 0 0 15px rgba(239, 68, 68, 0.2);
    }

    /* Battery Nub (Positive Terminal) */
    .dying-battery-btn::after {
        content: '';
        position: absolute;
        right: -8px;
        top: 50%;
        transform: translateY(-50%);
        width: 6px;
        height: 16px;
        background: #ef4444;
        border-top-right-radius: 4px;
        border-bottom-right-radius: 4px;
        transition: all 0.4s ease;
    }

    /* Battery Fill indicating low/dying charge */
    .dying-battery-btn .battery-fill {
        position: absolute;
        left: 4px;
        top: 4px;
        bottom: 4px;
        width: 15%;
        background: #ef4444;
        border-radius: 6px;
        z-index: 1;
        animation: lowBatteryPulse 1.5s infinite alternate;
        transition: all 0.5s cubic-bezier(0.77, 0, 0.175, 1);
    }

    .dying-battery-btn .btn-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s ease;
    }

    .dying-battery-btn .battery-status-icon {
        font-size: 1.2rem;
        animation: iconBlink 1.2s infinite steps(2);
    }

    @@keyframes lowBatteryPulse {
        0% {
            opacity: 0.5;
            box-shadow: 0 0 5px rgba(239, 68, 68, 0.5);
        }
        100% {
            opacity: 1;
            box-shadow: 0 0 15px rgba(239, 68, 68, 0.9);
        }
    }

    @@keyframes iconBlink {
        0%, 100% { opacity: 1; color: #ef4444; }
        50% { opacity: 0.3; color: #ffffff; }
    }

    /* Hover States - Battery Charges Up! */
    .dying-battery-btn:hover {
        border-color: #10b981;
        background: rgba(16, 185, 129, 0.05);
        box-shadow: 0 0 25px rgba(16, 185, 129, 0.4);
        transform: scale(1.05);
        color: #ffffff;
    }

    .dying-battery-btn:hover::after {
        background: #10b981;
    }

    .dying-battery-btn:hover .battery-fill {
        width: calc(100% - 8px);
        background: linear-gradient(90deg, #10b981, #06b6d4);
        animation: none;
        box-shadow: 0 0 15px rgba(16, 185, 129, 0.6);
    }

    .dying-battery-btn:hover .battery-status-icon {
        animation: chargingActive 0.6s infinite linear;
        color: #ffffff;
    }

    @@keyframes chargingActive {
        0% { transform: scale(1); }
        50% { transform: scale(1.2); text-shadow: 0 0 8px #fff; }
        100% { transform: scale(1); }
    }

    /* Hero Image Styles */
    .hero-image-container {
        position: relative;
        display: inline-block;
    }

    .hero-img {
        transition: transform 0.5s ease;
        animation: floatImg 6s ease-in-out infinite;
    }

    .hero-image-container:hover .hero-img {
        transform: scale(1.02);
    }

    @@keyframes floatImg {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
        100% { transform: translateY(0px); }
    }

    /* Map Section Styling */
    .section-title {
        font-weight: 700;
        color: #1e293b;
    }

    /* Active Booking Widget Styles */
    @@keyframes pulseWarning {
        0% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.1); opacity: 0.7; }
        100% { transform: scale(1); opacity: 1; }
    }
    .pulse-icon {
        animation: pulseWarning 1.5s infinite ease-in-out;
    }
    .bg-emerald-gradient {
        background: linear-gradient(135deg, #10b981 0%, #06b6d4 100%);
    }

    /* Custom Leaflet Zoom styling */
    .leaflet-control-zoom {
        border: none !important;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.15) !important;
    }
    .leaflet-control-zoom-in, .leaflet-control-zoom-out {
        background-color: #0f172a !important;
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        transition: all 0.25s ease !important;
        width: 34px !important;
        height: 34px !important;
        line-height: 34px !important;
        font-family: 'Outfit', sans-serif !important;
        font-weight: 600 !important;
    }
    .leaflet-control-zoom-in:hover, .leaflet-control-zoom-out:hover {
        background-color: #10b981 !important;
        color: #ffffff !important;
        transform: scale(1.05) !important;
    }
    .leaflet-bar a:first-child {
        border-top-left-radius: 12px !important;
        border-top-right-radius: 12px !important;
    }
    .leaflet-bar a:last-child {
        border-bottom-left-radius: 12px !important;
        border-bottom-right-radius: 12px !important;
        border-bottom: none !important;
    }

    /* Live Network Dot pulse styling */
    .pulse-green-dot {
        width: 8px;
        height: 8px;
        background-color: #10b981;
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
        animation: pulseGreen 1.6s infinite;
    }

    @@keyframes pulseGreen {
        0% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
        }
        70% {
            transform: scale(1);
            box-shadow: 0 0 0 8px rgba(16, 185, 129, 0);
        }
        100% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
        }
    }

    /* Partners Marquee Styling */
    .partners-marquee-container {
        overflow: hidden;
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        padding: 1.5rem 0;
        background: #f8fafc;
    }
    .partners-marquee-container::before,
    .partners-marquee-container::after {
        content: '';
        position: absolute;
        top: 0;
        width: 15vw;
        height: 100%;
        z-index: 2;
        pointer-events: none;
    }
    .partners-marquee-container::before {
        left: 0;
        background: linear-gradient(90deg, #f8fafc 0%, transparent 100%);
    }
    .partners-marquee-container::after {
        right: 0;
        background: linear-gradient(-90deg, #f8fafc 0%, transparent 100%);
    }
    .partners-marquee-track {
        display: flex;
        gap: 2rem;
        animation: scrollMarquee 25s linear infinite;
        width: max-content;
        padding-left: 2rem;
    }
    .partners-marquee-track:hover {
        animation-play-state: paused;
    }
    .partner-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 1.25rem 1.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s ease;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        height: 100px;
        width: 290px;
        flex-shrink: 0;
    }
    .partner-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 20px -3px rgba(16, 185, 129, 0.08), 0 4px 6px -2px rgba(16, 185, 129, 0.04);
        border-color: rgba(16, 185, 129, 0.3);
    }
    .partner-logo-wrapper {
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8fafc;
        border-radius: 14px;
        border: 1px solid #e2e8f0;
        flex-shrink: 0;
    }
    .partner-info {
        flex-grow: 1;
    }
    .partner-name {
        font-family: 'Outfit', sans-serif;
        font-size: 1.1rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 0.1rem;
    }
    .partner-tag {
        font-size: 0.8rem;
        color: #64748b;
        font-weight: 500;
        display: block;
    }
    @@keyframes scrollMarquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(calc(-50% - 1rem)); }
    }

    /* Hero Slant Divider Styling */
    .hero-slant-divider {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        overflow: hidden;
        line-height: 0;
        z-index: 3;
    }
    .hero-slant-divider svg {
        position: relative;
        display: block;
        width: calc(100% + 1.3px);
        height: 60px;
    }
    .hero-slant-divider .shape-fill {
        fill: #f8fafc;
    }

    /* Pre-Footer CTA Banner Styles */
    .pre-footer-cta-banner {
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        background: linear-gradient(135deg, #06b6d4 0%, #10b981 100%);
        padding: 5.5rem 0;
        margin-top: 5rem;
        margin-bottom: -4rem; /* Pull down to overlay main container bottom padding and touch the footer */
        position: relative;
        z-index: 2;
        box-shadow: inset 0 10px 30px rgba(0, 0, 0, 0.05), 0 -10px 30px rgba(0, 0, 0, 0.03);
        overflow: hidden;
    }
    .pre-footer-cta-banner::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.12) 0%, transparent 60%);
        pointer-events: none;
    }
    .pre-footer-cta-banner .btn-light:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15) !important;
        background-color: #ffffff !important;
    }
    .pre-footer-cta-banner .btn-outline-light:hover {
        transform: translateY(-2px);
        background-color: rgba(255, 255, 255, 0.1) !important;
        border-color: #ffffff !important;
    }
</style>

<div class="container mt-4">
    <!-- Hero Section -->
    <div class="hero-panel mb-5">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6 hero-text-col position-relative" style="z-index: 2;">
                    <span class="badge-low-battery mb-3">
                        <span class="pulse-dot"></span> Low Battery Warning
                    </span>
                    <h1 class="hero-title mb-3">Stuck with a <span class="text-danger">Dying Battery</span>?</h1>
                    <p class="hero-subtitle mb-4">
                        Don't get stranded. Check real-time charging slot availability and book your charging spot instantly. Find your nearest EV charger now.
                    </p>
                    <div class="hero-cta-wrapper">
                        <a href="#map-section" class="dying-battery-btn">
                            <span class="battery-fill"></span>
                            <span class="btn-content">
                                <span class="battery-status-icon">⚡</span>
                                <span class="btn-text">Battery Low - Find Charger</span>
                            </span>
                        </a>
                    </div>
                    <!-- Trust Indicators / Social Proof -->
                    <div class="mt-4 d-flex flex-wrap align-items-center gap-3 text-white-50 small" style="font-family: 'Outfit', sans-serif;">
                        <span class="d-flex align-items-center"><i class="bi bi-geo-alt-fill text-emerald me-1.5"></i> 500+ Stations</span>
                        <span class="opacity-25 d-none d-sm-inline">|</span>
                        <span class="d-flex align-items-center"><i class="bi bi-lightning-charge-fill text-cyan me-1.5"></i> Real-time Slots</span>
                        <span class="opacity-25 d-none d-sm-inline">|</span>
                        <span class="d-flex align-items-center"><i class="bi bi-shield-check-fill text-emerald me-1.5"></i> Instant Booking</span>
                    </div>
                </div>
                <div class="col-lg-6 hero-image-col text-center position-relative" style="z-index: 2;">
                    <div class="hero-image-container">
                        <img src="/images/hero-ev-solution.png" alt="EV charging solution" class="img-fluid hero-img" style="max-height: 420px; object-fit: contain; filter: drop-shadow(0 10px 20px rgba(6, 182, 212, 0.15));" />
                    </div>
                </div>
            </div>
        </div>
        <!-- Slanted SVG Divider -->
        <div class="hero-slant-divider">
            <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
                <path d="M1200 120L0 120 0 0z" class="shape-fill"></path>
            </svg>
        </div>
    </div>

    <!-- Partners Section -->
    <div class="partners-section mb-5 py-3">
        <div class="text-center mb-4">
            <h5 class="text-uppercase tracking-wider text-muted small fw-bold mb-1"><i class="bi bi-handshake text-emerald me-2"></i>Our Partners</h5>
