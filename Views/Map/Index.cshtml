                            <path d="M 35,65 L 50,35 L 65,65" stroke="#ffffff" stroke-width="8" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                            <circle cx="50" cy="30" r="6" fill="#06b6d4" />
