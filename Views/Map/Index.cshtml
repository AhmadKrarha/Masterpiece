                            <circle cx="50" cy="50" r="10" fill="#10b981" />
                        </svg>
                    </div>
                    <div class="partner-info">
                        <div class="partner-name">JoPetrol</div>
                        <span class="partner-tag">Jordan Petrol Refinery Co.</span>
                    </div>
                </div>

                <!-- Card 2: Manaseer Oil & Gas -->
