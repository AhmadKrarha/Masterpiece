@using System.Security.Claims
@inject Materpiece.Data.ApplicationDbContext _dbContext
@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Your EV Solution</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Materpiece.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg height="32" width="27" viewBox="5 8 70 85" xmlns="http://www.w3.org/2000/svg" class="d-inline-block">
                      <defs>
                        <linearGradient id="evGradientNav" x1="0%" y1="0%" x2="100%" y2="100%">
                          <stop offset="0%" stop-color="#06b6d4" /> 
                          <stop offset="100%" stop-color="#10b981" /> 
                        </linearGradient>
                      </defs>
                      <path d="M 40 10 C 22.327 10 8 24.327 8 42 C 8 66 40 90 40 90 C 40 90 72 66 72 42 C 72 24.327 57.673 10 40 10 Z" fill="url(#evGradientNav)" />
                      <path d="M 44 22 L 28 46 L 38 46 L 34 66 L 54 38 L 42 38 Z" fill="#ffffff" />
                    </svg>
                    <span class="ms-2 fw-extrabold text-uppercase tracking-wider text-gradient" style="font-family: 'Outfit', sans-serif; font-size: 1.2rem; font-weight: 800; background: linear-gradient(135deg, #06b6d4 0%, #10b981 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; letter-spacing: 0.5px; line-height: 1.2;">
                        Your EV Solution
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Map" && currentAction == "Index" ? "active" : "")" asp-area="" asp-controller="Map" asp-action="Index">Find Charger</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "AboutUs" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="AboutUs">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "ContactUs" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="ContactUs">Contact Us</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
                            bool showDashboard = User.IsInRole("Admin") || (userId != null && _dbContext.Stations.Any(s => s.OwnerId == userId));
                            if (showDashboard)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Dashboard" ? "active" : "")" asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer mt-5">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-5 col-md-6">
                    <h5 class="footer-brand-title text-white mb-3">⚡ Your EV Solution</h5>
                    <p class="footer-desc text-muted mb-3">Jordan's leading smart EV reservation platform. Find available charging slots, reserve instantly, and charge with absolute peace of mind.</p>
                    <div class="footer-social-icons">
                        <a href="https://instagram.com" target="_blank" class="social-link-icon me-2"><i class="bi bi-instagram"></i></a>
                        <a href="https://x.com" target="_blank" class="social-link-icon me-2"><i class="bi bi-twitter-x"></i></a>
                        <a href="https://github.com/AhmadKrarha" target="_blank" class="social-link-icon"><i class="bi bi-github"></i></a>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="text-white mb-3">Quick Navigation</h5>
                    <ul class="list-unstyled footer-links">
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Map" asp-action="Index">Find Station</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="AboutUs">About Us</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="ContactUs">Contact Us</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-12">
                    <h5 class="text-white mb-3">Contact Support</h5>
                    <ul class="list-unstyled footer-contact">
                        <li class="mb-2 text-muted"><i class="bi bi-geo-alt me-2 text-emerald"></i> Amman, Jordan</li>
                        <li class="mb-2 text-muted"><i class="bi bi-envelope me-2 text-emerald"></i> <a href="mailto:Ahmadkrarha@gmail.com" class="text-muted">Ahmadkrarha@gmail.com</a></li>
                        <li class="mb-2 text-muted"><i class="bi bi-telephone me-2 text-emerald"></i> <a href="tel:+962780976759" class="text-muted">+962 780 976 759</a></li>
                    </ul>
                </div>
            </div>
            <hr class="mt-4 mb-4 border-secondary opacity-25">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <p class="mb-0 text-muted small">&copy; 2026 Your EV Solution. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                    <p class="mb-0 text-muted small">Crafted with ⚡ by Eng. Ahmad Krarha</p>
                </div>
            </div>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
