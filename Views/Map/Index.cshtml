                <div class="partner-card">
                    <div class="partner-logo-wrapper">
                        <svg width="42" height="42" viewBox="0 0 100 100">
                            <path d="M 50,10 C 25,10 15,35 15,65 C 15,80 30,85 50,90 C 70,85 85,80 85,65 C 85,35 75,10 50,10 Z" fill="#e11d48" />
                            <path d="M 50,18 C 32,18 24,38 24,62 C 24,72 34,78 50,82 C 66,78 76,72 76,62 C 76,38 68,18 50,18 Z" fill="#fbbf24" />
                        </svg>
                    </div>
                    <div class="partner-info">
                        <div class="partner-name">Shell Jordan</div>
                        <span class="partner-tag">Shell Stations Jordan</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Map Section -->
    <div id="map-section" class="mb-5 pt-4">
        <div class="row mb-4">
            <div class="col-12">
                <div class="ps-3 border-start border-4" style="border-left: 4px solid #10b981 !important;">
                    <span class="badge bg-emerald-gradient text-white text-uppercase tracking-wider small fw-bold mb-2" style="font-size: 0.72rem; letter-spacing: 1.5px; padding: 6px 12px; border-radius: 100px;">Live Booking Network</span>
                    <h2 class="section-title h2 fw-bold text-dark mb-1" style="font-family: 'Outfit', sans-serif;">Find an Available EV Charging Station</h2>
                    <p class="text-muted mb-0">Explore near-real-time slot tracking and book your charging windows instantly.</p>
                </div>
            </div>
        </div>

        <div class="d-flex rounded border shadow-sm" style="height: 600px; overflow: hidden; position: relative;">
            <!-- Floating Active Booking Widget -->
            <div id="activeBookingWidget" class="card shadow-lg border-0 d-none" style="position: absolute; top: 20px; left: 20px; z-index: 1001; width: 320px; background: rgba(15, 23, 42, 0.9); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 20px; color: #fff;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-emerald-gradient text-white text-uppercase tracking-wider small fw-bold" id="widgetStatusBadge">Upcoming Session</span>
                        <button type="button" class="btn-close btn-close-white btn-sm opacity-50 shadow-none" onclick="hideBookingWidget()" aria-label="Close"></button>
                    </div>
                    <h6 class="fw-bold mb-1 text-white" id="widgetStationName">Station Name</h6>
                    <p class="text-white-50 small mb-3"><i class="bi bi-outlet me-1"></i> <span id="widgetSlotNumber">Slot 01</span></p>
                    
                    <div class="d-flex align-items-center gap-3 bg-white bg-opacity-10 p-3 rounded-4 border border-white border-opacity-10">
                        <div class="fs-2 text-emerald">
                            <i class="bi bi-hourglass-split" id="widgetTimerIcon"></i>
                        </div>
                        <div>
                            <span class="text-white-50 small d-block" id="widgetTimerLabel">Starts in</span>
                            <span class="fw-bold text-white fs-4" id="widgetCountdown">00:00:00</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Floating Live Network Stats Widget -->
            <div id="networkStatsWidget" class="card shadow-lg border-0" style="position: absolute; bottom: 20px; left: 20px; z-index: 1001; width: 280px; background: rgba(15, 23, 42, 0.9); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 20px; color: #fff; transition: all 0.3s ease;">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="pulse-green-dot"></span>
                        <span class="text-white-50 text-uppercase tracking-wider fw-bold" style="font-size: 0.72rem; letter-spacing: 1px;">Live Network Status</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-1.5">
                        <span class="text-white-50 small">Active Stations</span>
                        <span class="fw-bold text-white" id="statsStationCount">-- Stations</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-white-50 small">Available Slots</span>
                        <span class="fw-bold text-emerald" id="statsSlotCount">-- Slots</span>
                    </div>
                </div>
            </div>

            <div id="driverMap" style="flex-grow: 1; height: 100%;"></div>
            <div id="stationSidebar" style="width: 380px; display: none; background-color: #fff; border-left: 1px solid #ddd; height: 100%; overflow-y: auto; z-index: 1000;">
                <div id="sidebarContent">
                </div>
            </div>
        </div>
    </div>

    <!-- Pre-Footer CTA Banner -->
    <div class="pre-footer-cta-banner">
        <div class="container py-5 text-center text-white">
            <h3 class="fw-bold mb-3 h2" style="font-family: 'Outfit', sans-serif; font-size: 2.2rem; letter-spacing: -0.5px;">Ready to Charge Smarter?</h3>
            <p class="mb-4 opacity-90 mx-auto" style="max-width: 600px; font-size: 1.1rem; line-height: 1.6;">Join Jordan's premier smart EV reservation network today. Lock in your charging slots and skip the queues.</p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="AboutUs" class="btn btn-light px-4 py-2.5 fw-bold text-dark border-0 shadow-sm" style="border-radius: 10px; transition: all 0.25s ease;">Learn More</a>
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-light px-4 py-2.5 fw-bold" style="border-radius: 10px; transition: all 0.25s ease; border-color: rgba(255, 255, 255, 0.45);">Get Started</a>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
    
    const map = L.map('driverMap').setView([31.9522, 35.9106], 12);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    
    fetch('/Map/GetStationsJson')
        .then(response => response.json())
        .then(stations => {
            // Calculate live network stats
            const totalStations = stations.length;
            const totalAvailableSlots = stations.reduce((sum, s) => sum + s.availableSlots, 0);
            
            document.getElementById('statsStationCount').innerText = `${totalStations} Stations`;
            document.getElementById('statsSlotCount').innerText = `${totalAvailableSlots} Slots`;

            stations.forEach(station => {

                
                var marker = L.marker([station.latitude, station.longitude]).addTo(map);

                marker.stationId = station.stationId;

                
                marker.on('click', function(e) {
                    var clickedStationId = e.target.stationId

                 fetch('/Admin/Stations/GetSidebarDetails/' + clickedStationId)
                        .then(res => {
                            if (!res.ok) throw new Error("Station details could not be loaded.");
                            return res.text();
                        })
                        .then(htmlContents => {
                            document.getElementById('sidebarContent').innerHTML = htmlContents;

                            document.getElementById('stationSidebar').style.display = 'block';})
        
                        .catch(err => console.error("AJAX Error:", err));
                });

            });
        })
        .catch(err => console.error("Fetch Stations Error:", err));

    // Active Booking Countdown
    let countdownInterval = null;

    function hideBookingWidget() {
        document.getElementById('activeBookingWidget').classList.add('d-none');
        if (countdownInterval) clearInterval(countdownInterval);
    }

    function initBookingCountdown() {
        fetch('/Map/GetActiveBookingJson')
            .then(res => res.json())
            .then(data => {
                if (!data.hasBooking) return;

                document.getElementById('widgetStationName').innerText = data.stationName;
                document.getElementById('widgetSlotNumber').innerText = data.slotNumber;
                document.getElementById('activeBookingWidget').classList.remove('d-none');

                const serverOffset = new Date(data.serverTime).getTime() - Date.now();
                const startTime = new Date(data.startTime).getTime();
                const endTime = new Date(data.endTime).getTime();

                const updateTimer = () => {
                    const adjustedNow = Date.now() + serverOffset;

                    let targetTime, label, badgeText, badgeClass, iconClass;
                    let isSessionActive = false;

                    if (adjustedNow < startTime) {
                        targetTime = startTime;
                        label = "Starts in";
                        badgeText = "Upcoming Session";
                        badgeClass = "bg-emerald-gradient text-white";
                        iconClass = "bi bi-hourglass-split text-emerald";
                    } else if (adjustedNow >= startTime && adjustedNow <= endTime) {
                        targetTime = endTime;
                        label = "Time Remaining";
                        badgeText = "Charging Active";
                        badgeClass = "bg-warning text-dark";
                        iconClass = "bi bi-lightning-charge-fill text-warning pulse-icon";
                        isSessionActive = true;
                    } else {
                        // Finished
                        hideBookingWidget();
                        location.reload(); // Refresh to update slot statuses on map
                        return;
                    }

                    const diff = targetTime - adjustedNow;
                    const hours = Math.floor(diff / 3600000);
                    const minutes = Math.floor((diff % 3600000) / 60000);
                    const seconds = Math.floor((diff % 60000) / 1000);

                    const pad = (num) => String(num).padStart(2, '0');
                    document.getElementById('widgetCountdown').innerText = `${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
                    document.getElementById('widgetTimerLabel').innerText = label;
                    
                    const badge = document.getElementById('widgetStatusBadge');
                    badge.innerText = badgeText;
                    badge.className = `badge ${badgeClass} text-uppercase tracking-wider small fw-bold`;

                    const icon = document.getElementById('widgetTimerIcon');
                    icon.className = iconClass;
                };

                updateTimer();
                countdownInterval = setInterval(updateTimer, 1000);
            })
            .catch(err => console.error("Countdown error:", err));
    }

    // Initialize on load
    document.addEventListener("DOMContentLoaded", initBookingCountdown);
</script>