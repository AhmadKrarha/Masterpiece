@model Station

@{
    ViewData["Title"] = "Edit Charging Station";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<style>
    body {
        background-color: #f8fafc;
    }

    .glass-admin-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(16, 185, 129, 0.12);
        border-radius: 28px;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.04);
        padding: 2.5rem;
    }

    .admin-card-header {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #fff;
        border-radius: 20px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        border-bottom: 4px solid #10b981;
    }

    .input-custom-brand {
        background-color: #f1f5f9 !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 12px !important;
        padding: 0.8rem 1rem !important;
        transition: all 0.2s ease !important;
        font-weight: 500;
    }

    .input-custom-brand:focus {
        background-color: #ffffff !important;
        border-color: #10b981 !important;
        box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15) !important;
    }

    .btn-brand-gradient {
        background: linear-gradient(135deg, #10b981 0%, #06b6d4 100%);
        border: none;
        border-radius: 14px;
        color: #fff;
        font-weight: 700;
        padding: 0.9rem 2rem;
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.2);
        transition: all 0.25s ease;
        cursor: pointer;
    }

    .btn-brand-gradient:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(16, 185, 129, 0.3);
        color: #fff;
    }

    .btn-brand-gradient:active {
        transform: translateY(0);
    }

    .btn-custom-cancel {
        border-radius: 14px;
        padding: 0.9rem 2rem;
        font-weight: 600;
        transition: all 0.25s ease;
    }

    #stationMap {
        border: 2px solid rgba(16, 185, 129, 0.2);
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
    }
</style>

<div class="container mt-4 mb-5">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="admin-card-header shadow-sm d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <span class="text-white-50 text-uppercase small tracking-wider fw-bold">Admin Hub</span>
                    <h4 class="text-white fw-bold mb-0 mt-1">Edit Station: @Model.Name</h4>
                </div>
                <span class="fs-4 text-emerald">⚡</span>
            </div>

            <div class="glass-admin-card shadow-sm">
                <form asp-area="Admin" asp-controller="Stations" asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="StationId" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold text-secondary small">Station Name</label>
                        <input asp-for="Name" class="form-control input-custom-brand" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-bold text-secondary small">Street Address</label>
                        <input asp-for="Address" class="form-control input-custom-brand" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold text-secondary small">Description / Instructions</label>
                        <textarea asp-for="Description" class="form-control input-custom-brand" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="TotalSlots" class="form-label fw-bold text-secondary small">Total Charging Slots</label>
                        <input asp-for="TotalSlots" type="number" class="form-control input-custom-brand" min="1" />
                        <span asp-validation-for="TotalSlots" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-emerald small">Modify Location on Map</label>
                        <p class="text-muted small">Click a new spot on the map to relocate your station's pin if needed.</p>

                        <div id="stationMap" style="height: 350px; width: 100%;" class="mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Latitude" class="form-label small text-muted">Latitude</label>
                                <input asp-for="Latitude" id="latInput" class="form-control input-custom-brand bg-light" readonly />
                                <span asp-validation-for="Latitude" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Longitude" class="form-label small text-muted">Longitude</label>
                                <input asp-for="Longitude" id="lngInput" class="form-control input-custom-brand bg-light" readonly />
                                <span asp-validation-for="Longitude" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4 text-muted opacity-25">

                    <div class="d-flex justify-content-between">
                        <a href="/Admin/Stations" class="btn btn-outline-secondary btn-custom-cancel">Back to List</a>
                        <button type="submit" class="btn btn-brand-gradient">Update Station <i class="bi bi-check-circle-fill ms-1"></i></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
    // Grab the existing coordinates directly from our C# Model metadata
    const initialLat = @Model.Latitude;
    const initialLng = @Model.Longitude;

    // Center map precisely on the station's existing location
    const map = L.map('stationMap').setView([initialLat, initialLng], 15);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    // Seed the map with a pre-existing marker pin at the database location
    let selectedMarker = L.marker([initialLat, initialLng]).addTo(map);

    // Allow user to click to move the pin locations
    map.on('click', function(e) {
        const clickedLat = e.latlng.lat.toFixed(6);
        const clickedLng = e.latlng.lng.toFixed(6);

        document.getElementById('latInput').value = clickedLat;
        document.getElementById('lngInput').value = clickedLng;

        selectedMarker.setLatLng(e.latlng);
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}