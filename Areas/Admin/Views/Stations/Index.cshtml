@model IEnumerable<Station>

@{
    ViewData["Title"] = "My Charging Stations";
}

<style>
    body {
        background-color: #f8fafc;
    }

    .glass-admin-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(16, 185, 129, 0.12);
        border-radius: 28px;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.04);
        padding: 2.2rem;
    }

    .btn-brand-gradient {
        background: linear-gradient(135deg, #10b981 0%, #06b6d4 100%);
        border: none;
        border-radius: 14px;
        color: #fff;
        font-weight: 700;
        padding: 0.8rem 1.6rem;
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.2);
        transition: all 0.25s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-brand-gradient:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(16, 185, 129, 0.3);
        color: #fff;
    }

    .table-admin-custom {
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }

    .table-admin-custom th {
        background-color: #0f172a !important;
        color: #ffffff !important;
        font-weight: 700;
        font-size: 0.88rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 1.1rem 1.2rem;
        border-bottom: 3px solid #10b981 !important;
    }

    .table-admin-custom td {
        padding: 1.2rem 1.2rem;
        vertical-align: middle;
        font-size: 0.95rem;
        color: #334155;
        border-bottom: 1px solid #f1f5f9;
        background-color: #ffffff;
        transition: background-color 0.25s ease;
    }

    .table-admin-custom tr:hover td {
        background-color: #f8fafc;
    }

    .table-admin-custom tr:last-child td {
        border-bottom: none;
    }

    .btn-action-edit {
        border-radius: 10px;
        border: 1.5px solid #06b6d4;
        color: #06b6d4;
        background: transparent;
        font-weight: 600;
        font-size: 0.88rem;
        padding: 0.4rem 0.9rem;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .btn-action-edit:hover {
        background-color: #06b6d4;
        color: #fff !important;
        box-shadow: 0 4px 12px rgba(6, 182, 212, 0.2);
    }

    .btn-action-delete {
        border-radius: 10px;
        border: 1.5px solid #ef4444;
        color: #ef4444;
        background: transparent;
        font-weight: 600;
        font-size: 0.88rem;
        padding: 0.4rem 0.9rem;
        transition: all 0.2s ease;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .btn-action-delete:hover {
        background-color: #ef4444;
        color: #fff !important;
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);
    }

    .badge-slots-count {
        background: rgba(16, 185, 129, 0.08);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.15);
        font-weight: 700;
        font-size: 0.88rem;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        display: inline-block;
    }
</style>

<div class="container mt-4">
    @Html.AntiForgeryToken()

    <div class="glass-admin-card shadow-sm mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <span class="text-muted text-uppercase small tracking-wider fw-bold">Admin Hub</span>
                <h2 class="fw-bold mb-0 text-dark">My Charging Stations</h2>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <a asp-area="Admin" asp-controller="Stations" asp-action="Create" class="btn-brand-gradient">
                    <i class="bi bi-plus-circle-fill"></i> Add New Station
                </a>
            }
        </div>

        <div class="table-responsive table-admin-custom">
            <table class="table mb-0 w-100">
                <thead>
                    <tr>
                        <th>Station Name</th>
                        <th>Address</th>
                        <th>Total Slots</th>
                        <th>Coordinates (Lat, Lng)</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="bi bi-geo-fill fs-1 text-muted opacity-50 mb-3 d-block"></i>
                                <h6 class="fw-bold text-secondary">No Charging Stations Found</h6>
                                <p class="text-muted small mb-0">You haven't added any stations yet. Click "Add New Station" to begin!</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr id="station-row-@item.StationId">
                                <td class="fw-bold text-dark">@item.Name</td>
                                <td>@item.Address</td>
                                <td>
                                    <span class="badge-slots-count">@item.TotalSlots Slots</span>
                                </td>
                                <td class="text-secondary small font-monospace">@item.Latitude, @item.Longitude</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-area="Admin" asp-controller="Stations" asp-action="Edit" asp-route-id="@item.StationId" class="btn-action-edit">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                        <button type="button" class="btn-action-delete" onclick="confirmDelete(@item.StationId, '@JavaScriptStringEncode(item.Name)')">
                                            <i class="bi bi-trash3-fill"></i> Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    public static string JavaScriptStringEncode(string value)
    {
        return System.Web.HttpUtility.JavaScriptStringEncode(value ?? "");
    }
}

<!-- SweetAlert2 CDN & AJAX Logic -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function confirmDelete(stationId, stationName) {
        Swal.fire({
            title: 'Delete Station?',
            html: `Are you sure you want to delete <strong>${stationName}</strong>?<br><span class="text-danger small">Warning: This will permanently delete all charger slots, reviews, payments, and reservations associated with this station. This action cannot be undone.</span>`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#64748b',
            confirmButtonText: '<i class="bi bi-trash3-fill me-1"></i> Yes, delete it!',
            cancelButtonText: 'Cancel',
            customClass: {
                popup: 'rounded-4',
                confirmButton: 'fw-bold',
                cancelButton: 'fw-bold'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                // Show delete in progress
                Swal.fire({
                    title: 'Deleting Station...',
                    html: 'Please wait while we remove the station and its related bookings.',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                // Send Delete POST request
                fetch(`/Admin/Stations/Delete/${stationId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    }
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error("Failed to contact the server.");
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '⚡ Deleted!',
                            text: data.message,
                            confirmButtonColor: '#10b981',
                            customClass: {
                                popup: 'rounded-4'
                            }
                        }).then(() => {
                            // Smoothly fade out and remove row from DOM
                            const row = document.getElementById(`station-row-${stationId}`);
                            if (row) {
                                row.style.transition = 'all 0.5s ease';
                                row.style.opacity = '0';
                                setTimeout(() => {
                                    row.remove();
                                    // If table is now empty, reload to show placeholder card
                                    location.reload();
                                }, 500);
                            } else {
                                location.reload();
                            }
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Delete Failed',
                            text: data.message,
                            confirmButtonColor: '#10b981'
                        });
                    }
                })
                .catch(error => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: error.message || 'Unable to delete the station at this time.',
                        confirmButtonColor: '#10b981'
                    });
                });
            }
        });
    }
</script>